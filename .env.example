# Copy this file to .env and fill in real values from your Supabase project.

# Project Settings > Database > Connection string (Transaction pooler, port 6543)
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"

# Same page, Session pooler (port 5432) — used by the Prisma CLI only
# (migrate, db seed, validate). See prisma.config.ts.
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Project Settings > API (keep secret). Needed to run `npm run db:seed`, and
# now also required at runtime for File Attachments (Supabase Storage
# uploads/downloads/deletes go through a service-role admin client — see
# src/lib/storage/admin-client.ts). Never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# resend.com → API Keys (keep secret). Used server-side only, to send
# invitation emails. If unset, invites/resends still work — the app falls
# back to "created, but the email could not be sent" and the Copy link
# button, it just never calls Resend.
RESEND_API_KEY="your-resend-api-key"

# The "From" address for invitation emails. Must be on a domain verified in
# your Resend account (resend.com/domains) — unverified domains will be
# rejected by Resend at send time.
INVITATION_FROM_EMAIL="Client Portal CRM <invites@yourdomain.com>"

# Server-only base URL used to build the /invite/{token} link inside
# invitation emails — deliberately NOT NEXT_PUBLIC_ (never read on the
# client, never built from a request's Host header). No trailing slash.
# Optional on Vercel: falls back to `https://${VERCEL_URL}` (set
# automatically for every deployment) if omitted, and to
# http://localhost:3000 in local dev.
APP_BASE_URL="https://your-production-domain.com"
