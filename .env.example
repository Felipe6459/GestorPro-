# Copy this file to .env and fill in real values from your Supabase project.

DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# GestorPro platform identity
PLATFORM_NAME="GestorPro"
PLATFORM_TAGLINE="Gestão de clientes, cobranças e pagamentos em um só lugar"
PLATFORM_LOGO_URL=""
PLATFORM_FAVICON_URL=""

# Platform MASTER. The real production value belongs in Vercel/Supabase
# environment settings, never in source code or a committed .env file.
PLATFORM_ADMIN_EMAILS="felipemedeiros6459@gmail.com"

RESEND_API_KEY="your-resend-api-key"
INVITATION_FROM_EMAIL="GestorPro <invites@yourdomain.com>"
APP_BASE_URL="https://your-production-domain.com"
CRON_SECRET="a-long-random-value-never-committed"

PLATFORM_BILLING_EMAIL=""
PLATFORM_REPLY_TO_EMAIL=""
PLATFORM_LEGAL_NAME="GestorPro"
PLATFORM_LEGAL_ADDRESS=""
PLATFORM_SUPPORT_EMAIL=""
PLATFORM_JURISDICTION=""
PRIVACY_POLICY_EFFECTIVE_DATE=""
TOS_EFFECTIVE_DATE=""

# Billing provider (server-only)
BILLING_PROVIDER=
BILLING_ENVIRONMENT=
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=
BILLING_STARTER_PRICE_ID=
BILLING_PRO_PRICE_ID=
NEXT_PUBLIC_BILLING_CLIENT_TOKEN=
