# GestorPro — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA coloque chaves, senhas ou tokens reais neste arquivo do GitHub.

# Supabase / PostgreSQL
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# E-mail / convites
RESEND_API_KEY="your-resend-api-key"
INVITATION_FROM_EMAIL="GestorPro <invites@yourdomain.com>"
APP_BASE_URL="https://your-production-domain.com"

# Cron
CRON_SECRET="generate-a-long-random-secret"

# Identidade GestorPro
PLATFORM_NAME="GestorPro"
PLATFORM_TAGLINE="Gestão de clientes, planos, vencimentos, cobranças e pagamentos"
PLATFORM_LOGO_URL=""
PLATFORM_FAVICON_URL=""
PLATFORM_LEGAL_NAME="GestorPro"
PLATFORM_LEGAL_ADDRESS=""
PLATFORM_SUPPORT_EMAIL=""
PLATFORM_JURISDICTION="Brasil"
PLATFORM_BILLING_EMAIL=""
PLATFORM_REPLY_TO_EMAIL=""
PRIVACY_POLICY_EFFECTIVE_DATE=""
TOS_EFFECTIVE_DATE=""

# MASTER da plataforma
# O valor real deve ser configurado nas variáveis de ambiente da Vercel.
# Não coloque senha do MASTER neste arquivo.
PLATFORM_ADMIN_EMAILS="felipemedeiros6459@gmail.com"

# Billing do SaaS (Paddle), quando for habilitado
BILLING_PROVIDER=""
BILLING_ENVIRONMENT=""
BILLING_API_KEY=""
BILLING_WEBHOOK_SECRET=""
BILLING_STARTER_PRICE_ID=""
BILLING_PRO_PRICE_ID=""
NEXT_PUBLIC_BILLING_CLIENT_TOKEN=""
