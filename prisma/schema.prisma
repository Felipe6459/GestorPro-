// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum ClientStatus {
  LEAD
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ActivityEntityType {
  CLIENT
  PROJECT
  TASK
  INVOICE
  MEMBERSHIP
  INVITATION
  ATTACHMENT
}

enum ActivityAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  DELETED
  INVITATION_SENT
  INVITATION_RESENT
  INVITATION_CANCELED
  INVITATION_ACCEPTED
  ROLE_CHANGED
  OWNERSHIP_TRANSFERRED
  MEMBER_REMOVED
  MEMBER_LEFT
  FILE_UPLOADED
  FILE_DELETED
}

enum AttachmentEntityType {
  CLIENT
  PROJECT
  INVOICE
}

// id is intended to match Supabase auth.users.id once auth is wired up.
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  avatarUrl String?
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedProjects Project[] @relation("ProjectOwner")
  assignedTasks Task[]    @relation("TaskAssignee")
  clients       Client[]  @relation("ClientOwner")

  memberships         Membership[]
  sentInvitations     Invitation[]  @relation("InvitationInvitedBy")
  activities          Activity[]    @relation("ActivityActor")
  uploadedAttachments Attachment[]  @relation("AttachmentUploadedBy")
}

// Multi-tenant scaffolding (schema-only for now; not yet wired into app
// logic). Business entities below carry a nullable organizationId so
// existing single-user data keeps working unchanged.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  invitations Invitation[]
  activities  Activity[]

  clients     Client[]
  projects    Project[]
  tasks       Task[]
  invoices    Invoice[]
  attachments Attachment[]
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id        String           @id @default(uuid()) @db.Uuid
  email     String
  role      Role             @default(MEMBER)
  token     String           @unique
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invitedById String? @db.Uuid
  invitedBy   User?   @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
}

model Client {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  email     String?
  phone     String?
  company   String?
  status    ClientStatus @default(LEAD)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  userId String @db.Uuid
  user   User   @relation("ClientOwner", fields: [userId], references: [id], onDelete: Restrict)

  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  projects Project[]
  invoices Invoice[]

  @@unique([userId, email])
  @@index([status])
  @@index([userId])
  @@index([organizationId])
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?      @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  clientId String @db.Uuid
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  ownerId String @db.Uuid
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  tasks    Task[]
  invoices Invoice[]

  @@index([status])
  @@index([ownerId])
  @@index([organizationId])
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String? @db.Uuid
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([dueDate])
  @@index([organizationId])
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  notes         String?
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  clientId String @db.Uuid
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([clientId, invoiceNumber])
  @@index([status])
  @@index([dueDate])
  @@index([projectId])
  @@index([organizationId])
}

// Append-only audit log. Never updated or deleted by app code (see
// createActivity(), added in a later stage). entityId is deliberately not a
// foreign key: Client/Project/Task/Invoice rows can be deleted while their
// Activity history must remain readable — metadata carries a snapshot of
// the entity (and, since actorId can go null, of the actor) taken at write
// time, so this row never depends on either still existing.
model Activity {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Nullable: no action deletes a User today, but Membership.userId -> User
  // is already onDelete: Cascade elsewhere in this schema, so if that ever
  // changes, the actor's own history shouldn't vanish or block the delete.
  actorId String? @db.Uuid
  actor   User?   @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  entityType ActivityEntityType
  entityId   String             @db.Uuid
  action     ActivityAction

  // Snapshot + diff data only (e.g. { field, from, to } or a deleted
  // entity's display name) — never full form payloads, tokens, or secrets.
  metadata Json @default("{}")

  createdAt DateTime @default(now())

  // General organization timeline: ORDER BY createdAt DESC, id DESC.
  @@index([organizationId, createdAt, id])
  // Entity-specific timeline (a later stage) — scoped by org first so a
  // foreign entityId can never be queried across tenants.
  @@index([organizationId, entityType, entityId, createdAt, id])
}

// File attachments for Client/Project/Invoice, stored in Supabase Storage.
// entityId is deliberately not a foreign key, same reasoning as Activity —
// this stays a single simple association that extends to Task later with
// just an enum value, no new migration for a new column. Unlike Activity,
// an Attachment is a live resource tied to its parent, not a historical
// record: deleting the parent entity must explicitly delete both this row
// and its Storage object as part of that same operation (added when the
// entity delete flows are wired up) — there's no onDelete Cascade here to
// do that automatically, since entityId has no FK to cascade from.
model Attachment {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Nullable, same reasoning as Activity.actorId: no action deletes a User
  // today, but if one ever does, the file shouldn't vanish or block the
  // delete just because this is who uploaded it.
  uploadedById String? @db.Uuid
  uploadedBy   User?   @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  entityType AttachmentEntityType
  entityId   String               @db.Uuid

  storageBucket String
  // The actual Supabase Storage object key — unique because it's built
  // server-side from a fresh attachmentId, never from user input alone.
  storagePath String @unique
  originalName String
  mimeType     String
  sizeBytes    Int

  createdAt DateTime @default(now())

  // General "attachments for this org" and entity-specific listings both
  // read newest-first — id included for the same stable-tiebreak reason
  // as Activity's indexes, even though this stage doesn't add pagination.
  @@index([organizationId, entityType, entityId, createdAt, id])
  @@index([organizationId, createdAt, id])
}
